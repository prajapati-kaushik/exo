{
    "name": "linkorb/exo",
    "description": "Exo Integration Engine: FaaS, Actions, Triggers",
    "homepage": "http://www.github.com/linkorb/exo",
    "keywords": [
        "func",
        "action",
        "trigger",
        "faas",
        "exo",
        "linkorb"
    ],
    "type": "library",
    "authors": [
        {
            "name": "Joost Faassen",
            "email": "j.faassen@linkorb.com",
            "role": "Development"
        }
    ],
    "require": {
        "php": ">=7.0",
        "andrewfenn/pid-helper": "^0.1.0",
        "justinrainbow/json-schema": "^5.0",
        "linkorb/boost": "^1.0",
        "linkorb/collection": "^1.0",
        "linkorb/config": "^1.0",
        "monolog/monolog": "^2.1 || ^3.0",
        "nyholm/psr7": "^1.1",
        "psr/http-client": "^1.0",
        "symfony/console": "^4.0|^5.0|^6.0|^7.0",
        "symfony/dotenv": "^3.0|^4.0|^5.0|^6.0|^7.0",
        "symfony/http-client": "^4.3|^5.0|^6.0|^7.0",
        "symfony/mailer": "^5.0|^6.0|^7.0",
        "symfony/mime": "^5.0|^6.0|^7.0",
        "symfony/process": "^3.0|^4.0|^5.0|^6.0|^7.0",
        "symfony/property-access": "^5.1",
        "symfony/yaml": "^3.0|^4.0|^5.0|^6.0|^7.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "build": "echo 'noop'",
        "qa-checks": [
            "@phpstan",
            "@phpcs",
            "@phpcf",
            "@security-check"
        ],
        "phpstan": "./vendor/bin/phpstan analyze --level=5 ./src/",
        "phpcs": "./vendor/bin/phpcs ./src/",
        "phpcf": "./vendor/bin/phpcf --target 7.1 ./src/",
        "security-check": "./vendor/bin/security-checker security:check ./composer.lock"
    },
    "autoload": {
        "psr-4": {
            "Exo\\": "src/"
        }
    },
    "bin": [
        "bin/exo"
    ],
    "license": "MIT",
    "require-dev": {
        "phpstan/phpstan": "^2.0.0",
        "phpstan/phpstan-symfony": "^2.0.0",
        "squizlabs/php_codesniffer": "^3.5",
        "wapmorgan/php-deprecation-detector": "^2.0",
         "workfront/nats": "^2.0.0"
    },
    "replace": {
        "vlucas/phpdotenv": "*"
    }
}
